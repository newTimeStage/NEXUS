---
import Header from '../components/Header.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  article?: {
    date?: string | number | Date;
    author?: string;
    category?: string;
    headings?: { text: string }[];
  };
  hasMermaid?: boolean;
}

const { title, description, article, hasMermaid } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = 'https://nexus-6gs.pages.dev';
const pageUrl = `${siteUrl}${currentPath}`;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} - NEXUS` : 'NEXUS - 人类文明记载'}</title>
    {description ? (
      <>
        <meta name="description" content={description} />
        <meta property="og:description" content={description} />
        <meta name="twitter:description" content={description} />
      </>
    ) : (
      <>
        <meta name="description" content="载人类史，一切系于此。人类文明全记录，録人群文明发展之实，俾后嗣毋更始。" />
        <meta property="og:description" content="载人类史，一切系于此。人类文明全记录，録人群文明发展之实，俾后嗣毋更始。" />
        <meta name="twitter:description" content="载人类史，一切系于此。人类文明全记录，録人群文明发展之实，俾后嗣毋更始。" />
      </>
    )}
    <meta property="og:title" content={title ? `${title} - NEXUS` : 'NEXUS - 人类文明记载'} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={`https://nexus-6gs.pages.dev${currentPath}`} />
    <meta property="og:image" content="https://nexus-6gs.pages.dev/favicon.ico" />
    <meta property="og:site_name" content="NEXUS" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ? `${title} - NEXUS` : 'NEXUS - 人类文明记载'} />
    <link rel="canonical" href={pageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(article ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BreadcrumbList',
          'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'NEXUS', 'item': siteUrl },
            { '@type': 'ListItem', 'position': 2, 'name': article.category || '', 'item': `${siteUrl}/${encodeURIComponent(article.category || '')}/` },
            { '@type': 'ListItem', 'position': 3, 'name': title, 'item': pageUrl },
          ],
        },
        {
          '@type': 'Article',
          'headline': title,
          'url': pageUrl,
          ...(article.date && !isNaN(new Date(article.date).getTime()) ? { 'datePublished': new Date(article.date).toISOString() } : {}),
          ...(article.author ? { 'author': { '@type': 'Person', 'name': article.author } } : {}),
          ...(article.category ? { 'articleSection': article.category } : {}),
          'publisher': { '@type': 'Organization', 'name': 'NEXUS' },
        },
      ],
    } : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'NEXUS',
      'url': siteUrl,
      'description': '载人类史，一切系于此。人类文明全记录。',
      'inLanguage': 'zh-CN',
    })} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/global.css" />
    <meta name="theme-color" content="#f7f3ee" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

    <script is:inline src="https://cdn.jsdelivr.net/npm/chinese-lunar-calendar@1.0.1/dist/index.js" defer></script>
    <script src="../scripts/mermaid-loader.ts"></script>
  </head>
  <body>
    <iframe src="/screencode.html" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; border: none; z-index: -1; pointer-events: none;"></iframe>

    <div id="readingProgress" class="reading-progress"></div>

    <Header />
    <SearchOverlay />

    <main class="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <Footer />

    <button class="back-to-top" id="backToTop" aria-label="返回顶部">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <script is:inline>
      const backToTop = document.getElementById('backToTop');
      window.addEventListener('scroll', () => {
        if (backToTop) backToTop.classList.toggle('visible', window.scrollY > 400);
      }, { passive: true });
      backToTop && backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      const progressBar = document.getElementById('readingProgress');
      window.addEventListener('scroll', () => {
        if (!progressBar) return;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          progressBar.style.width = Math.min((window.scrollY / docHeight) * 100, 100) + '%';
        }
      }, { passive: true });
    </script>
  </body>
</html>
