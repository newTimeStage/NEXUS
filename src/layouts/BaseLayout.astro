<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NEXUS - 人类文明记载</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css" integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/global.css" />
    <style>
      /* Mermaid 图表样式 */
      .mermaid {
        display: flex;
        justify-content: center;
        margin: 2rem 0;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        overflow-x: auto;
      }

      .mermaid svg {
        max-width: 100%;
        height: auto;
      }

      /* 暗色主题适配 */
      [data-theme="dark"] .mermaid {
        background: rgba(0, 0, 0, 0.2);
      }

    </style>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chinese-lunar-calendar@1.0.1/dist/index.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <script is:inline>
      function initMermaid() {
        if (typeof mermaid !== 'undefined') {
          mermaid.initialize({
            startOnLoad: true,
            theme: document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default',
            flowchart: {
              useMaxWidth: true,
              htmlLabels: true,
              curve: 'basis'
            },
            securityLevel: 'loose'
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMermaid);
      } else {
        initMermaid();
      }
    </script>
  </head>
  <body>
    <!-- 背景粒子效果 -->
    <iframe src="/screencode.html" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; border: none; z-index: -1; pointer-events: none;"></iframe>

    <header class="header">
      <div class="container">
        <h1 class="logo">NEXUS</h1>
        <nav class="nav">
          <a href="/">首页</a>
          <a href="/文明根基/">文明根基</a>
          <a href="/演进轨迹/">演进轨迹</a>
          <a href="/制度与创造/">制度与创造</a>
          <a href="/主体与未来/">主体与未来</a>
        </nav>
        <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
          <span class="theme-icon">🌞</span>
        </button>
      </div>
    </header>

    <main class="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <p>© 2026 NEXUS 人类文明记载</p>
        <p>秉中 · 纳洪 · 守贞</p>
      </div>
    </footer>

    <script>
      // Theme toggle logic
      const themeToggle = document.getElementById('themeToggle');
      if (themeToggle) {
        const themeIcon = themeToggle.querySelector('.theme-icon');
        if (themeIcon) {
          const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', savedTheme);
          themeIcon.textContent = savedTheme === 'dark' ? '🌞' : '🌙';

          themeToggle.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            themeIcon.textContent = newTheme === 'dark' ? '🌞' : '🌙';
          });
        }
      }

      // 外部链接处理函数 - 在新窗口中显示内容，不下载
      function openExternalLinkInNewWindow(url: string, title: string) {
        console.log('openExternalLinkInNewWindow called with:', url, title);
        
        // 对 URL 和标题进行编码
        const encodedUrl = encodeURIComponent(url);
        const encodedTitle = encodeURIComponent(title);
        
        // 构建中间页面 URL
        const proxyUrl = `/external-link?url=${encodedUrl}&title=${encodedTitle}`;
        
        // 在新窗口打开
        window.open(proxyUrl, '_blank', 'width=1024,height=768,scrollbars=yes,toolbar=yes,menubar=yes,location=yes');
      }

      // 链接处理逻辑 - 使用立即执行或 DOMContentLoaded
      function initLinkHandlers() {
        console.log('initLinkHandlers called, readyState:', document.readyState);
        console.log('pathname:', window.location.pathname);

        if (window.location.pathname === '/pdf-viewer') {
          return;
        }

        const links = document.querySelectorAll('a');
        console.log('Found links:', links.length);

        for (let i = 0; i < links.length; i++) {
          const link = links[i] as HTMLAnchorElement;
          const href = link.getAttribute('href');
          if (href) {
            const isPdf = href.toLowerCase().endsWith('.pdf');
            const isExternal = /^https?:\/\//i.test(href) && href.indexOf(window.location.hostname) === -1;

            if (isPdf || isExternal) {
              console.log('Adding click handler to:', href, 'isPdf:', isPdf, 'isExternal:', isExternal);
              link.addEventListener('click', function(e) {
                console.log('Link clicked:', href);
                e.preventDefault();
                let title = (link.textContent || '').trim() || '外部链接';
                title = title.replace(/^打开：+/g, '');
                let targetUrl = href;
                if (!/^https?:\/\//i.test(href) && href.indexOf('/') !== 0) {
                  targetUrl = '/' + href;
                }
                openExternalLinkInNewWindow(targetUrl, title);
              });
            }
          }
        }
      }

      console.log('Script loaded, readyState:', document.readyState);
      // 如果 DOM 已加载完成，立即执行；否则等待 DOMContentLoaded
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLinkHandlers);
      } else {
        initLinkHandlers();
      }


    </script>
  </body>
</html>
