---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <h2>系</h2>
    <p>载人类史，一切系于此</p>
    <div class="date-info">
      <span class="gregorian-date" id="gregorian-date"></span>
      <span class="lunar-date" id="lunar-date"></span>
    </div>
    <div class="other-calendars">
      <span id="shang-yuan-jin-nian"></span>
      <span id="kai-yuan-jin-nian"></span>
      <span id="shi-yuan-jin-nian"></span>
    </div>
    <div class="heng-jing-li" id="heng-jing-li"></div>
  </section>

  <section class="intro">
    <h3>志曰</h3>
    <blockquote>
      録人群文明发展之实，俾后嗣毋更始。
    </blockquote>
  </section>

  <section class="principles">
    <h3>立极三枢</h3>
    <div class="principles-grid">
      <div class="principle-item">
        <h4>秉中</h4>
        <p>超然政教之外，不役于权势，不惑于宗派，不囿于时识。惟实是存，惟真是守，以立万世公信之基。</p>
      </div>
      <div class="principle-item">
        <h4>纳洪</h4>
        <p>文明之迹，无论华夷显隐、盛衰远近，靡不载录。包举宇内，无遗无偏，以成其大。</p>
      </div>
      <div class="principle-item">
        <h4>守贞</h4>
        <p>考事必溯其源，证言必核其实。参伍以通其变，析疑以存其真，使源流清澈，永世不淆。</p>
      </div>
    </div>
  </section>

  <section class="structure">
    <h3>结构体例</h3>
    <p>文明三阶，法天、地、人三才之序。立四部，定十三门，经纬昭然，使源流不紊。</p>
    <div class="structure-grid">
      <div class="structure-item">
        <h4><a href="/文明根基/">甲部：文明根基</a></h4>
        <p style="margin-top:0.5rem;font-size:0.85rem;color:var(--text-tertiary);">人正论 · 地理志 · 天文传</p>
      </div>
      <div class="structure-item">
        <h4><a href="/演进轨迹/">乙部：演进轨迹</a></h4>
        <p style="margin-top:0.5rem;font-size:0.85rem;color:var(--text-tertiary);">时序纲 · 事鉴记 · 民生志 · 交流鉴 · 技术谱</p>
      </div>
      <div class="structure-item">
        <h4><a href="/制度与创造/">丙部：制度与创造</a></h4>
        <p style="margin-top:0.5rem;font-size:0.85rem;color:var(--text-tertiary);">政典书 · 思想流 · 艺文汇 · 全科书</p>
      </div>
      <div class="structure-item">
        <h4><a href="/主体与未来/">丁部：主体与未来</a></h4>
        <p style="margin-top:0.5rem;font-size:0.85rem;color:var(--text-tertiary);">人物传 · 镜鉴录</p>
      </div>
    </div>
  </section>

  <script>
    /** @returns {string} */
    function calculateHengJingLi(currentDate = new Date()) {
      var nianInShi = 30;
      var shiInYun = 12;
      var yunInHui = 30;
      var huiInYuan = 12;

      var shunInSeconds = 20;
      var keInShun = 12;
      var shiInKe = 30;
      var riInShi = 12;
      var yueInRi = 30;

      var keInSeconds = keInShun * shunInSeconds;
      var shiInSeconds = shiInKe * keInSeconds;
      var riInSeconds = riInShi * shiInSeconds;
      var yueInSeconds = yueInRi * riInSeconds;

      var epochOffset = 67017;
      var gregorianYear = currentDate.getFullYear();
      var hengJingLiYear = (currentDate.getMonth() === 11 && currentDate.getDate() >= 21) ? gregorianYear : gregorianYear - 1;
      var totalYears = hengJingLiYear + epochOffset;

      var yuan = Math.floor(totalYears / (huiInYuan * yunInHui * shiInYun * nianInShi)) + 1;
      var remainingAfterYuan = totalYears % (huiInYuan * yunInHui * shiInYun * nianInShi);
      var hui = Math.floor(remainingAfterYuan / (yunInHui * shiInYun * nianInShi)) + 1;
      var remainingAfterHui = remainingAfterYuan % (yunInHui * shiInYun * nianInShi);
      var yun = Math.floor(remainingAfterHui / (shiInYun * nianInShi)) + 1;
      var remainingAfterYun = remainingAfterHui % (shiInYun * nianInShi);
      var shi = Math.floor(remainingAfterYun / nianInShi) + 1;
      var nian = (remainingAfterYun % nianInShi) + 1;

      var winterSolstice = new Date(hengJingLiYear, 11, 21, 0, 0, 0);
      var totalSeconds = Math.floor((currentDate.getTime() - winterSolstice.getTime()) / 1000);

      var calculatedYue = Math.floor(totalSeconds / yueInSeconds) + 1;
      var calculatedRi = (Math.floor(totalSeconds / riInSeconds) % yueInRi) + 1;
      var calculatedShi = (Math.floor(totalSeconds / shiInSeconds) % riInShi) + 1;
      var calculatedKe = (Math.floor(totalSeconds / keInSeconds) % shiInKe) + 1;
      var calculatedShun = (Math.floor(totalSeconds / shunInSeconds) % keInShun) + 1;

      return yuan + '元' + hui + '会' + yun + '运' + shi + '世' + nian + '年' +
        calculatedYue + '月' + calculatedRi + '日' + calculatedShi + '时' +
        calculatedKe + '刻' + calculatedShun + '瞬';
    }

    function calculateShangYuanJiNian(currentDate = new Date()) {
      return '上元' + (currentDate.getFullYear() + 7737) + '年';
    }

    function calculateKaiYuanJiNian(currentDate = new Date()) {
      return '天元' + (currentDate.getFullYear() + 2697) + '年';
    }

    function calculateShiYuanJiNian(currentDate = new Date()) {
      return '始元' + currentDate.getFullYear() + '年';
    }

    // 更新所有日期显示
    function updateAllDates() {
      const today = new Date();

      // 更新公历日期
      const gregorianElement = document.getElementById('gregorian-date');
      if (gregorianElement) {
        try {
          gregorianElement.textContent = today.toLocaleDateString('zh-CN');
        } catch (e) {
          gregorianElement.textContent = today.toDateString();
        }
      }

      // 更新其他纪年（这些不依赖外部库）
      const shangYuanElement = document.getElementById('shang-yuan-jin-nian');
      if (shangYuanElement) {
        try {
          shangYuanElement.textContent = calculateShangYuanJiNian(today);
        } catch (e) {
          shangYuanElement.textContent = '上元纪年';
        }
      }

      const kaiYuanElement = document.getElementById('kai-yuan-jin-nian');
      if (kaiYuanElement) {
        try {
          kaiYuanElement.textContent = calculateKaiYuanJiNian(today);
        } catch (e) {
          kaiYuanElement.textContent = '天元纪年';
        }
      }

      const shiYuanElement = document.getElementById('shi-yuan-jin-nian');
      if (shiYuanElement) {
        try {
          shiYuanElement.textContent = calculateShiYuanJiNian(today);
        } catch (e) {
          shiYuanElement.textContent = '始元纪年';
        }
      }

      // 更新恒经历
      const hengJingLiElement = document.getElementById('heng-jing-li');
      if (hengJingLiElement) {
        try {
          hengJingLiElement.textContent = calculateHengJingLi(today);
        } catch (e) {
          hengJingLiElement.textContent = '恒经历';
        }
      }

      // 更新农历日期
      const lunarElement = document.getElementById('lunar-date');
      if (lunarElement) {
        try {
          // 使用 chinese-lunar-calendar 库（正确的 API）
          import('chinese-lunar-calendar').then((LunarCalendar) => {
            // 获取库的默认导出（CommonJS 模块）
            const calendar = LunarCalendar.default || LunarCalendar;
            const lunar = calendar.getLunar(today.getFullYear(), today.getMonth() + 1, today.getDate());

            // 农历月份（转换为汉字）
            const monthNames = ['正', '二', '三', '四', '五', '六', '七', '八', '九', '十', '冬', '腊'];
            const lunarMonth = lunar.isLeap ? '闰' + monthNames[lunar.lunarMonth - 1] + '月' : monthNames[lunar.lunarMonth - 1] + '月';

            // 农历日期（转换为汉字）
            const dayNames = ['初一', '初二', '初三', '初四', '初五', '初六', '初七', '初八', '初九', '初十', '十一', '十二', '十三', '十四', '十五', '十六', '十七', '十八', '十九', '二十', '廿一', '廿二', '廿三', '廿四', '廿五', '廿六', '廿七', '廿八', '廿九', '三十'];
            const lunarDay = dayNames[lunar.lunarDate - 1];

            // 节气（如"立夏"）
            const solarTerm = lunar.solarTerm || '';

            // 组合显示：使用库返回的干支年份
            lunarElement.textContent = `${lunar.lunarYear} 生肖${lunar.zodiac} ${lunarMonth} ${lunarDay}日 ${solarTerm}`;
          }).catch((error) => {
            console.error('Error with chinese-lunar-calendar:', error);
            // 降级处理：使用 date-chinese 库
            try {
              import('date-chinese').then((DateChinese) => {
                const lunar = new DateChinese.Lunar(today.getFullYear(), today.getMonth() + 1, today.getDate());
                const month = lunar.getMonth();
                const day = lunar.getDay();

                // 天干地支年份
                const tianGan = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
                const diZhi = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
                const yearGanZhi = tianGan[(today.getFullYear() - 4) % 10] + diZhi[(today.getFullYear() - 4) % 12];

                // 农历月份（转换为汉字）
                const monthNames = ['正', '二', '三', '四', '五', '六', '七', '八', '九', '十', '冬', '腊'];
                const lunarMonth = month > 0 ? monthNames[month - 1] + '月' : '闰' + monthNames[-month - 1] + '月';

                // 农历日期（转换为汉字）
                const dayNames = ['初一', '初二', '初三', '初四', '初五', '初六', '初七', '初八', '初九', '初十', '十一', '十二', '十三', '十四', '十五', '十六', '十七', '十八', '十九', '二十', '廿一', '廿二', '廿三', '廿四', '廿五', '廿六', '廿七', '廿八', '廿九', '三十'];
                const lunarDay = dayNames[day - 1];

                // 组合显示
                lunarElement.textContent = `${yearGanZhi}年 ${lunarMonth} ${lunarDay}`;
              }).catch((error2) => {
                console.error('Error with date-chinese:', error2);
                lunarElement.textContent = '农历日期';
              });
            } catch (e2) {
              console.error('Error with date-chinese:', e2);
              lunarElement.textContent = '农历日期';
            }
          });
        } catch (e) {
          console.error('Error in lunar date update:', e);
          lunarElement.textContent = '农历日期';
        }
      }
    }

    // 初始更新（使用 requestIdleCallback 避免阻塞首帧）
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => updateAllDates(), { timeout: 3000 });
    } else {
      updateAllDates();
    }

    // 每20秒更新一次（1瞬=20秒）
    setInterval(updateAllDates, 20000);
  </script>
</BaseLayout>