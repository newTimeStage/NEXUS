---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES } from '../../constants';
import DirectoryTree from '../../components/DirectoryTree.astro';

export async function getStaticPaths() {
  return CATEGORIES.map(category => ({
    params: { category },
  }));
}

const { category } = Astro.params as { category: string };

const articles = await getCollection(category as '文明根基' | '演进轨迹' | '制度与创造' | '主体与未来');

const introductionArticle = articles.find(article => article.id.endsWith('部序.md'));
const { Content: IntroductionContent } = introductionArticle ? await render(introductionArticle) : { Content: null };
const normalArticles = articles.filter(article => !article.id.endsWith('部序.md'));

interface TreeNode {
  type: 'directory' | 'file';
  children?: Record<string, TreeNode>;
  article?: any;
}

function buildDirectoryTree(articles: any[]): Record<string, TreeNode> {
  const tree: Record<string, TreeNode> = {};

  articles.forEach(article => {
    const pathParts = article.id.split('/');
    let currentLevel = tree;

    for (let i = 0; i < pathParts.length - 1; i++) {
      const part = pathParts[i];
      if (!currentLevel[part]) {
        currentLevel[part] = { type: 'directory', children: {} };
      }
      currentLevel = (currentLevel[part].children as Record<string, TreeNode>);
    }

    const fileName = pathParts[pathParts.length - 1];
    const fileNameWithoutExt = fileName.replace('.md', '');
    currentLevel[fileNameWithoutExt] = { type: 'file', article };
  });

  return tree;
}

const directoryTree = buildDirectoryTree(normalArticles);
---

<BaseLayout>
  <section class="category-index">
    {introductionArticle && IntroductionContent && (
      <div class="category-introduction">
        <IntroductionContent />
      </div>
    )}

    {directoryTree ? (
      <DirectoryTree tree={directoryTree} category={category} />
    ) : (
      <p class="no-articles">该分类下暂无文章</p>
    )}
  </section>
</BaseLayout>
