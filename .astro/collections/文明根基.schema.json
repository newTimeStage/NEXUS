{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "category": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  }
}